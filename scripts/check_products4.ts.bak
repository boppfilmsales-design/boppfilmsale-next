import { createClient } from '@libsql/client';
import * as dotenv from 'dotenv';
import * as path from 'path';

dotenv.config({ path: path.resolve(process.cwd(), '.env.local') });
dotenv.config();

const url = process.env.TURSO_DATABASE_URL;
const authToken = process.env.TURSO_AUTH_TOKEN;

async function main() {
  const db = createClient({ url, authToken });
  
  console.log('Fetching all products...');
  
  const products = await db.execute({
    sql: 'SELECT id, lang, name FROM products ORDER BY id'
  });
  
  console.log('Total products:', products.rows.length);
  
  // Show Chinese products with their IDs
  const cnProducts = products.rows.filter((p: any) => p.lang === 'cn');
  const enProducts = products.rows.filter((p: any) => p.lang === 'en');
  
  console.log('\nChinese products:');
  cnProducts.forEach((p: any) => console.log(`  ID ${p.id}: ${p.name}`));
  
  console.log('\nEnglish products:');
  enProducts.forEach((p: any) => console.log(`  ID ${p.id}: ${p.name}`));
  
  // Search for products to delete
  const toDelete = products.rows.filter((p: any) => 
    p.name.includes('安全套') || 
    p.name.includes('轮胎') || 
    p.name.includes('添加剂') ||
    p.name.toLowerCase().includes('condom') ||
    p.name.toLowerCase().includes('tire') ||
    p.name.toLowerCase().includes('additive')
  );
  
  console.log('\nProducts to delete:');
  toDelete.forEach((p: any) => console.log(`  ID ${p.id} (${p.lang}): ${p.name}`));
  
  await db.close();
  process.exit(0);
}

main().catch(e => { console.error(e); process.exit(1); });