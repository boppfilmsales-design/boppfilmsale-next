  "BOPP预涂膜": "BOPP Pre-coated Film",
};

async function main() {
  console.log('Translating English product names...');
  
  let updated = 0;
  let notFound = 0;
  
  for (const [cnName, enName] of Object.entries(translations)) {
    const result = await execute(
      "UPDATE products SET name = ? WHERE lang = 'en' AND name = ?",
      [enName, cnName]
    );
    if (result.rowsAffected > 0) {
      console.log(`  Updated: "${cnName}" → "${enName}" (${result.rowsAffected} rows)`);
      updated += result.rowsAffected;
    } else {
      notFound++;
    }
  }
  
  console.log(`\nTotal updated: ${updated} rows`);
  console.log(`Not found (already translated or different): ${notFound} entries`);
  
  process.exit(0);
}

main().catch(e => { console.error(e); process.exit(1); });